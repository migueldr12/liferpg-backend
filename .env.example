# Servidor (nube o LAN)
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Orígenes permitidos para CORS, separados por coma ("*" permite cualquiera)
CORS_ORIGINS=*
# Zona horaria del juego: decide qué día es "hoy" en los registros diarios (M06)
TIME_ZONE=America/Mexico_City


DATABASE_URL=

# Autenticación
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Firebase Cloud Messaging
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
