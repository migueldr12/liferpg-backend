# Servidor (nube o LAN)
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Orígenes permitidos para CORS, separados por coma ("*" permite cualquiera)
CORS_ORIGINS=*


DATABASE_URL=

# Autenticación
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Solo desarrollo, mientras no exista el login (M00): usuario por defecto si la
# petición no manda el encabezado x-user-id. Debe ser el id de MongoDB (24 caracteres)
# de un usuario real; en la app móvil va el mismo id en EXPO_PUBLIC_DEV_USER_ID.
DEV_USER_ID=
# Solo desarrollo: permite terminar una sesión de enfoque antes de tiempo (demos)
ALLOW_EARLY_FINISH=false

# Firebase Cloud Messaging
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
