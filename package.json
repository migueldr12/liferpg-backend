{
  "name": "liferpg-backend",
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "description": "API REST de Life-RPG (Node.js + Express, arquitectura modular limpia)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:check": "node scripts/check-database.js",
    "db:usuario-prueba": "node scripts/usuario-prueba.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "dotenv": "16.6.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
